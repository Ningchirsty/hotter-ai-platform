{
  "meta": {
    "name": "hotter-ai image workflow contracts",
    "version": "1",
    "status": "PUBLISHED",
    "updatedAt": "2026-09-21",
    "rules": [
      "每个 workflowCode 对应后端受控目录下的一份 ComfyUI API Format JSON 模板",
      "任务提交时后端深拷贝模板，仅覆写 mapping 白名单内的节点输入键",
      "四个 Qwen-Image-2.1 模板已在 ComfyUI 0.37.0（192.168.2.223:8188）真机验证出图（api/_validation-live.json），并于 2026-09-21 在生产环境完成端到端验收（上传→建任务→执行→轮询→产出校验，4/4 通过，记录见 docs/image-module-implementation-handoff.md 与生产运维记录），故状态提升为 PUBLISHED",
      "同一 workflowCode 的固定后台参数变化必须递增 version，禁止原地修改 PUBLISHED 版本",
      "前端仅可见 workflowCode/模型编码/字段白名单/计费展示（见 frontend/src/views/image/modules.ts）"
    ]
  },
  "capabilities": [
    {
      "capabilityCode": "T2I",
      "name": "文生图",
      "fields": [
        {
          "field": "prompt",
          "required": true,
          "type": "string",
          "maxLength": 1000
        },
        {
          "field": "negative_prompt",
          "required": false,
          "type": "string",
          "maxLength": 500
        },
        {
          "field": "size",
          "required": true,
          "type": "enum",
          "options": [
            "1:1 方图 · 1MP（1024×1024）",
            "4:3 横图 · 1MP（1152×864）",
            "3:4 竖图 · 1MP（864×1152）",
            "16:9 宽屏 · 1MP（1344×768）",
            "9:16 竖屏 · 1MP（768×1344）",
            "1:1 方图 · 2K（2048×2048）"
          ]
        }
      ],
      "workflows": [
        {
          "workflowCode": "wf-t2i-qwen21",
          "modelCode": "QWEN21",
          "version": "v0.1.0-draft",
          "status": "PUBLISHED",
          "apiJsonFile": "image/workflows/api/wf-t2i-qwen21-v0.1.0.json",
          "checksum": "d8a773d86c93240a6efe348db9c1ad2d96d4fcd92c75253d8aafc7109cdc7b15",
          "billing": {
            "type": "credits",
            "credits": 2
          },
          "mapping": [
            {
              "field": "prompt",
              "nodeId": "4",
              "inputKey": "prompt",
              "note": "正向提示词"
            },
            {
              "field": "negative_prompt",
              "nodeId": "4",
              "inputKey": "negative_prompt",
              "note": "cfg=1 时为官方路径，负向提示词通常留空"
            }
          ],
          "fixedParams": {
            "model": "Qwen-Image-2.1 int8_convrot",
            "textEncoder": "qwen3vl_8b_int8_convrot",
            "vae": "qwen_image_2.1_vae_bf16",
            "sampler": "euler",
            "scheduler": "simple",
            "steps": 25,
            "cfg": 1,
            "denoise": 1,
            "seedPolicy": "set by server per task",
            "sizePolicy": "由后端按 size 档位覆写节点 5 的 width/height"
          },
          "outputRule": {
            "nodeId": "8",
            "outputField": "images",
            "format": "png",
            "mime": "image/png",
            "multiple": false,
            "maxSizeMB": 32,
            "maxPixels": 4194304,
            "alpha": "preserved"
          },
          "perf": {
            "avgSeconds": 8,
            "maxSeconds": 60,
            "timeoutSeconds": 300,
            "concurrency": 1,
            "measuredNote": "真机实测（A100 40G，模型已驻留显存）：4.0s / 1024×1024"
          },
          "supportedOutputs": [
            {
              "size": "1:1 方图 · 1MP（1024×1024）",
              "width": 1024,
              "height": 1024
            },
            {
              "size": "4:3 横图 · 1MP（1152×864）",
              "width": 1152,
              "height": 864
            },
            {
              "size": "3:4 竖图 · 1MP（864×1152）",
              "width": 864,
              "height": 1152
            },
            {
              "size": "16:9 宽屏 · 1MP（1344×768）",
              "width": 1344,
              "height": 768
