            {
              "size": "9:16 竖屏 · 1MP（768×1344）",
              "width": 768,
              "height": 1344
            },
            {
              "size": "1:1 方图 · 2K（2048×2048）",
              "width": 2048,
              "height": 2048
            }
          ],
          "fixedFieldValidation": {
            "size": "1:1 方图 · 1MP（1024×1024）",
            "supportedSizes": [
              "1:1 方图 · 1MP（1024×1024）",
              "4:3 横图 · 1MP（1152×864）",
              "3:4 竖图 · 1MP（864×1152）",
              "16:9 宽屏 · 1MP（1344×768）",
              "9:16 竖屏 · 1MP（768×1344）",
              "1:1 方图 · 2K（2048×2048）"
            ]
          }
        }
      ]
