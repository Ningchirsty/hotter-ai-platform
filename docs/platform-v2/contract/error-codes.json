    "needsHuman": "转人工（对应任务状态 NEED_HUMAN）",
    "circuitBreak": "立即熔断该 Provider 并告警"
  },
  "codes": [
    { "code": "INVALID_REQUEST", "desc": "参数或输出Schema错误", "retryable": false, "needsHuman": true, "circuitBreak": false, "worthFallback": false, "http": 400, "source": "existing" },
    { "code": "POLICY_DENIED", "desc": "权限或外发策略拒绝", "retryable": false, "needsHuman": true, "circuitBreak": false, "worthFallback": false, "http": 403, "source": "existing" },
    { "code": "APPROVAL_REQUIRED", "desc": "需要调用审批（无有效授权）", "retryable": false, "needsHuman": true, "circuitBreak": false, "worthFallback": false, "http": 403, "source": "existing" },
    { "code": "RATE_LIMITED", "desc": "被限流", "retryable": true, "needsHuman": false, "circuitBreak": false, "worthFallback": true, "http": 429, "source": "existing" },
    { "code": "TIMEOUT", "desc": "调用超时", "retryable": true, "needsHuman": false, "circuitBreak": false, "worthFallback": true, "http": 504, "source": "existing" },
    { "code": "AUTH_FAILED", "desc": "鉴权失败", "retryable": false, "needsHuman": false, "circuitBreak": true, "worthFallback": true, "http": 401, "source": "existing" },
    { "code": "QUOTA_EXCEEDED", "desc": "额度或余额不足", "retryable": false, "needsHuman": true, "circuitBreak": true, "worthFallback": true, "http": 402, "source": "existing" },
    { "code": "UNAVAILABLE", "desc": "服务不可用", "retryable": true, "needsHuman": false, "circuitBreak": false, "worthFallback": true, "http": 503, "source": "existing" },
    { "code": "OUTPUT_UNPARSABLE", "desc": "结果不可解析", "retryable": false, "needsHuman": true, "circuitBreak": false, "worthFallback": true, "http": 502, "source": "existing" },
    { "code": "UNKNOWN", "desc": "未归类的错误", "retryable": false, "needsHuman": false, "circuitBreak": false, "worthFallback": true, "http": 500, "source": "existing" },

    { "code": "ARTIFACT_INVALID", "desc": "制品校验失败（MIME/大小/哈希不符）", "retryable": false, "needsHuman": true, "circuitBreak": false, "worthFallback": false, "http": 422, "source": "v2-addition" },
    { "code": "TOOL_FAILED", "desc": "工具调用失败（可重试）", "retryable": true, "needsHuman": false, "circuitBreak": false, "worthFallback": false, "http": 502, "source": "v2-addition" },
    { "code": "SECURITY_QUARANTINE", "desc": "安全隔离（检出恶意内容/越权脚本）", "retryable": false, "needsHuman": true, "circuitBreak": true, "worthFallback": false, "http": 403, "source": "v2-addition" }
  ],
  "notErrorCodes": {
    "$comment": "这些概念刻意不做成错误码",
    "APPROVAL_REJECTED": "审批驳回是任务状态 REJECTED（业务流程的正常分支），不是调用失败；做成错误码会把业务退回算进灰度失败率",
    "TIMED_OUT": "超时是原因不是状态：用状态 FAILED + errorCode=TIMEOUT 表达"
