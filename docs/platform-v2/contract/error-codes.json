  "reasonCodes": {
    "$comment": "errorCode 是可编程的粗分类（决定重试/熔断/转人工）；reasonCode 是给人看的细因。不要把细因做成错误码。",
    "recommended": [
      "EXTERNAL_DISALLOWED",
      "DATA_LEVEL_TOO_HIGH",
      "NO_ROUTE_POLICY",
      "NO_MODEL_BOUND",
      "MODEL_TAGS_MISMATCH",
      "RUNTIME_UNHEALTHY",
      "ORG_SCOPE_DENIED",
      "TOOL_NOT_GRANTED",
      "TOOL_RISK_NEEDS_APPROVAL",
      "ARTIFACT_OUT_OF_SCOPE",
      "SANDBOX_EVIDENCE_MISSING"
    ]
  },
  "docMapping": {
