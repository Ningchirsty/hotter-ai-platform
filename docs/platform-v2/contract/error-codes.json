    "DEPENDENCY_UNAVAILABLE": "UNAVAILABLE",
    "RUNTIME_TIMEOUT": "TIMEOUT",
    "RATE_LIMITED": "RATE_LIMITED",
    "TOOL_FAILED_RETRYABLE": "TOOL_FAILED",
