        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.7</version>
        </dependency>

        <!-- 说明：DOC/DOCX 文本提取使用 org.apache.poi:poi-ooxml，
             已由 fesod-sheet 传递提供，故不在此重复声明。 -->

