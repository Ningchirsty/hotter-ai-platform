<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-ai-gov</artifactId>

    <description>
        ruoyi-ai-gov AI治理模块（模型能力接入与配置管控）
    </description>

    <dependencies>

        <!-- 通用工具 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- SM4 加解密：治理层写入模型密钥时必须产出与 snail-ai 一致的密文。
             显式声明而非依赖传递，避免上游依赖调整后编译期才暴露（版本由 hutool-bom 管理）。 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
        </dependency>

        <!-- SM4 的 JCE Provider：**hutool-crypto 自己不实现 SM4**，它只是把
             SM4/CBC/PKCS5Padding 交给 JCE；而 JDK 21 的 SunJCE 里没有 SM4，
             hutool 会优先用 BouncyCastle。少了它，AigModelSecretCipher 的
             @PostConstruct 自检会抛异常、**整个应用起不来**（这是刻意设计，
             但前提是 provider 真的在 classpath 上）。
             与 ruoyi-common-encrypt 用同一对依赖（bcpkix + hutool-crypto），
             bcprov/bcutil 由 bcpkix 传递引入。
             为什么要显式声明：此前它只是被 ruoyi-system → ruoyi-common-encrypt
             顺带带上来的——因为没有人触发过一次真实的 SM4，本模块的单测里
             AigModelSecretCipher 一直被 mock，所以「本模块自己缺 provider」这件事
             在自身的构建里完全看不见；一旦按设计把子包拆成微服务（§15），
             或者部署时裁掉 ruoyi-system，启动就会失败在自检上。 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
        </dependency>

        <!-- api模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-api</artifactId>
        </dependency>

        <!-- web服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <!-- 数据库服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <!-- 权限认证模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-satoken</artifactId>
        </dependency>

        <!-- 安全模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <!-- 日志记录 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <!-- 缓存服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-redis</artifactId>
        </dependency>

        <!-- JSON模块 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-json</artifactId>
        </dependency>

        <!-- 翻译模块：VO 的字典标签（@Translation）依赖，与 ruoyi-talent 同口径 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-translation</artifactId>
        </dependency>

        <!-- AI公共模块：用于注入 snail-ai 的 OpenApiChatClient。
             optional=true 避免把三个 snail-ai starter 传递到其它模块；
             snail-ai.enabled=false 时相关 Bean 不存在，实现类一律以
             @ConditionalOnClass / @ConditionalOnBean 条件加载。 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-ai</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 单元测试：路由引擎的数据等级硬约束（STRICT 禁止外发）必须有测试钉住，
             否则「策略配错也能拦得住」这条不变式只存在于注释里。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
