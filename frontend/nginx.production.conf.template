server {
    listen ${LISTEN_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 512m;

    location = /version.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri =404;
    }

    location = /prod-api {
        return 301 /prod-api/;
    }

    location /prod-api/ {
        proxy_pass ${BACKEND_ORIGIN}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /prod-api;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        add_header Cache-Control "no-store" always;
        expires -1;
    }

    # 成片内容与素材缩略图：必须让后端自己的 Cache-Control 生效。
    #
    # 这里刻意不继承 /prod-api/ 的 no-store —— 预览和拖动进度条会反复取同一段字节，
    # 而经 Cloudflare 的单程 TTFB 实测就有 1.3 秒左右（直连源站只要 8 毫秒），
    # 每次都回源的代价很高。后端对这两个接口发的是 private, max-age=300：
    # 只允许浏览器私有缓存 5 分钟，不改变"必须带登录态才能取"的边界。
    #
    # 用正则 location 精确限定到这两个路径，避免上传/列表/删除等 JSON 接口
    # 失去 no-store。
    location ~ ^/prod-api/video/assets/[0-9]+/(content|thumbnail)$ {
        rewrite ^/prod-api/(.*)$ /$1 break;
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /prod-api;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
